{
  "builds": [
    {
      "src": "groupProj/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "groupProj/frontend/dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/groupProj/frontend/index.html"
    }
  ]
}
